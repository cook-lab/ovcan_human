/reports/**/*.png
/reports/**/*.pdf
/reports/**/*.docx
/reports/**/*.html
/logs/
/tmp/
/figs/
/Rplots.pdf

# Superseded meeting/working artifacts; manuscript v5 onward is retained
/docs/*.pptx
/docs/*.docx
/docs/*.pdf

