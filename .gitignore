# Workstation, credentials and local runtime state
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
.Rhistory
.RData
.Ruserdata
.Rproj.user/
__pycache__/
*.py[cod]
.venv/
venv/
renv/library/
renv/staging/
renv/cache/
.codex/
.agents/

# Original inputs stay on managed storage. Retain the historical source notebooks.
/judy_archive/*
!/judy_archive/notebooks/
/judy_archive/notebooks/*
!/judy_archive/notebooks/*.Rmd
/data/cluster_wes_retrieval/
/data/external/
/data/reference/*.fa
/data/reference/*.fa.gz
/data/reference/tx2gene_ensembl_rel105.csv

