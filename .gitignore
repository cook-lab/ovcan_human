/output/rna_txi.rds
/output/external/OmicsExpressionProteinCodingGenesTPMLogp1.csv
/output/external/OmicsSomaticMutationsMatrixDamaging.csv

# Preserve source/review reports; omit duplicate snapshots and render scratch work
/reports/_*/
/reports/integration_logs/
/reports/audit_2026-09-05/before*/
/reports/audit_2026-09-05/rna_before/
/reports/audit_2026-09-05/docx_render*/
/reports/figure_redesign_2026-09-05/before/
