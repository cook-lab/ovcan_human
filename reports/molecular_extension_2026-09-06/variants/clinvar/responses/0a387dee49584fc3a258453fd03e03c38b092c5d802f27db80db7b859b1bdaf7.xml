        <ClinVarAccession Accession="SCV000581147" DateUpdated="2024-05-01" DateCreated="2017-07-01" Type="SCV" Version="6" SubmitterName="Ambry Genetics" OrgID="61756" OrganizationCategory="laboratory" OrgAbbreviation="Ambry"/>
        <RecordStatus>current</RecordStatus>
        <Classification DateLastEvaluated="2016-10-12">
          <ReviewStatus>flagged submission</ReviewStatus>
          <GermlineClassification>Uncertain significance</GermlineClassification>
          <Citation>
            <ID Source="PubMed">15469940</ID>
