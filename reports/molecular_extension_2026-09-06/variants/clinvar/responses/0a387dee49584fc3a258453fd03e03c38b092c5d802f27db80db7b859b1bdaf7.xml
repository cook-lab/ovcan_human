        <ClinVarAccession Accession="SCV003317129" DateUpdated="2026-02-23" DateCreated="2023-02-07" Type="SCV" Version="4" SubmitterName="Labcorp Genetics (formerly Invitae), Labcorp" OrgID="500031" OrganizationCategory="laboratory"/>
